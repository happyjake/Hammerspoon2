<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>org.hammerspoon.Hammerspoon2</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hammerspoon2</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- CrossWin reaches the Windows agent over an SSH local-forward at
		     http://127.0.0.1:8473. Permit insecure HTTP to local/loopback
		     destinations (loopback is a reserved range covered by this key). -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSAccessibilityUsageDescription</key>
	<string>Hammerspoon 2 requires accessibility permissions to control your Mac</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Hammerspoon 2 uses Bluetooth to connect to the CrossMac relay device (ESP32) for cross-Mac control.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_voicekb-cs._tcp</string>
		<string>_voicekb-cs._udp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Hammerspoon 2 uses the local network to sync the clipboard and transfer data between your Macs for the CrossMac feature.</string>
	<key>SUFeedURL</key>
	<string>https://www.hammerspoon.org/appcast2.xml</string>
	<!-- Build identity: every build carries the source commit and date it was
	     made from, so a fleet of Macs can be compared by `defaults read` instead
	     of by binary hash. Filled from build settings passed on the xcodebuild
	     command line (see vibecast's scripts/hs2-fleet.sh); empty otherwise. -->
	<key>HS2SourceCommit</key>
	<string>$(HS2_SOURCE_COMMIT)</string>
	<key>HS2BuildDate</key>
	<string>$(HS2_BUILD_DATE)</string>
</dict>
</plist>
